DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/bijoux_test


JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bijoux
CLOUDINARY_REMOVE_BACKGROUND=false

OPENAI_API_KEY=
# Two pins in app/core/config.py, separate since task 2.4: OPENAI_MODEL for
# vision and OPENAI_STYLIST_PIN for the stylist, so 1.11's re-pin of the vision
# model cannot silently move the stylist's. Uncomment only to override.
# Leaving them set-but-empty would override the pin with an empty string, which
# is why they are commented rather than blank.
#OPENAI_VISION_MODEL=
#OPENAI_STYLIST_MODEL=
OPENAI_TIMEOUT_SECONDS=30

USE_FAKE_AI=false
CORS_ORIGINS=http://localhost:4200,https://bijoux.vercel.app
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=20
ENV=development